{
    "sdl3": {
        "git_link": "git@github.com:libsdl-org/SDL.git",
        "description": "Simple Directmedia Layer ",
        "repository_url": "https://github.com/libsdl-org/SDL",
        "repo_type": "static",
        "cmake_alias": "SDL3::SDL3",
        "instructions": {
            "install": [
                "git clone :git_link :cache_path",
                "cp -r :cache_path :target_path"
            ],
            "uninstall": [
                "rm -rf target/debug/deps/:requested_package"
            ],
            "version": [
                "cd :current_path/target/debug/deps/:package_name && git describe --tags --abbrev=0"
            ]
        },
        "tags": [
            "Media",
            "Layer"
        ]
    }
}